@page "/"
@rendermode InteractiveWebAssembly
@using ASCII_Hero.Client.Game
@using ASCII_Hero.Client.Game.Assets
@using ASCII_Hero.Client.Game.Browser
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject HttpClient Http

<PageTitle>ASCII Hero</PageTitle>

<!--
    image-rendering: pixelated tells the browser NOT to smooth/blur the canvas
    contents. This matters because our font is a true bitmap font (crisp,
    square pixels by design) - without this, the browser's default smoothing
    would blur those sharp edges when the canvas is scaled by the browser
    (e.g. on high-DPI displays), undermining the retro look we bundled the
    font for in the first place.
-->
<canvas id="game-canvas" width="1280" height="700" style="background:black; display:block; margin:0 auto; image-rendering:pixelated;"></canvas>

@code {
    private CanvasBridge? _canvasBridge;
    private GameLoop? _gameLoop;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canvasBridge = new CanvasBridge(JsRuntime);
            _gameLoop = new GameLoop(_canvasBridge, new HttpAssetFileProvider(Http));
            await _gameLoop.StartAsync("game-canvas");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_canvasBridge is not null)
        {
            await _canvasBridge.DisposeAsync();
        }
    }
}
